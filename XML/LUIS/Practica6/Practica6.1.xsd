<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:simpleType name="tipoDoctor">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Cifuentes"/>
            <xs:enumeration value="Casado"/>
            <xs:enumeration value="Imaz"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="tipoSexo">
        <xs:restriction base="xs:boolean"/>
    </xs:simpleType>

    <xs:complexType name="tipoHabitacion">
        <xs:simpleContent>
            <xs:extension base="xs:int">
                <xs:attribute name="camas" type="xs:int" use="required"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="tipoPaciente">
        <xs:sequence>
            <xs:element name="nombre" type="xs:string"/>
            <xs:element name="habitacion" type="tipoHabitacion"/>
            <xs:element name="doctor" type="tipoDoctor"/>
            <xs:element name="fechaNacimiento" type="xs:date"/>
            <xs:element name="varon" type="tipoSexo"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="tipoHospital">
        <xs:sequence>
            <xs:element name="paciente" type="tipoPaciente" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="hospital" type="tipoHospital"/>

</xs:schema>
