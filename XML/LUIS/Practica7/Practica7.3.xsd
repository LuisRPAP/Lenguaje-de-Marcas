<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:simpleType name="tipoEficiencia">
        <xs:restriction base="xs:string">
            <xs:enumeration value="A"/>
            <xs:enumeration value="B"/>
            <xs:enumeration value="C"/>
            <xs:enumeration value="D"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="tipoAccesorios">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Panel"/>
            <xs:enumeration value="Puerta"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="tipoElectrodomestico">
        <xs:sequence>
            <xs:element name="referencia" type="xs:string"/>
            <xs:element name="tipo">
                <xs:complexType>
                    <xs:simpleContent>
                        <xs:extension base="xs:string">
                            <xs:attribute name="eficiencia" type="tipoEficiencia" use="required"/>
                        </xs:extension>
                    </xs:simpleContent>
                </xs:complexType>
            </xs:element>

            <xs:element name="marca">
                <xs:complexType>
                    <xs:simpleContent>
                        <xs:extension base="xs:string">
                            <xs:attribute name="modelo" type="xs:string" use="optional"/>
                        </xs:extension>
                    </xs:simpleContent>
                </xs:complexType>
            </xs:element>

            <xs:element name="precioVenta" type="xs:decimal"/>
            <xs:element name="precioCoste" type="xs:decimal" minOccurs="0"/>
            <xs:element name="color" type="xs:string" maxOccurs="unbounded"/>

            <xs:element name="instalacion">
                <xs:complexType>
                    <xs:simpleContent>
                        <xs:extension base="xs:string">
                            <xs:attribute name="accesorios" type="tipoAccesorios" use="required"/>
                        </xs:extension>
                    </xs:simpleContent>
                </xs:complexType>
            </xs:element>

            <xs:element name="localidad" type="xs:string"/>
            <xs:element name="año" type="xs:gYear"/>
            <xs:element name="unidades" type="xs:int"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="almacen">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="electrodomestico" type="tipoElectrodomestico" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
