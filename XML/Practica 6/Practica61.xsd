<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="Tdoctor">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Cifuentes"/>
      <xs:enumeration value="Casado"/>
      <xs:enumeration value=""/>
    </xs:restriction>
  </xs:simpleType>
<xs:complexType name="THabitacion">
  <xs:simpleContent>
    <xs:extension base="xs:integer">
      <xs:attribute name="Numero_de_camas" type="xs:integer" />
    </xs:extension>
  </xs:simpleContent>
</xs:complexType>
  <xs:element name="hospital">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="paciente" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Nombre" type="xs:string"/>
              <xs:element name="Habitacion" type="THabitacion"/>
              <xs:element name="Doctor" type="Tdoctor"/>
              <xs:element name="fechaNacimiento" type="xs:string"/>
              <xs:element name="Varon" type="xs:boolean"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
